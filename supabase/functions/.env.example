# Web Push (VAPID) keys for Supabase Edge Functions. Copy to supabase/functions/.env (git-ignored).
# Generate once; changing them later forces every student to turn reminders on again.
# Upload with: pnpm exec supabase secrets set --env-file supabase/functions/.env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact push services can use if something goes wrong (mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.org
# Shared secret pg_cron sends to send-reminders; also stored in Supabase Vault (see docs).
REMINDERS_CRON_SECRET=
