{
  "name": "@ebenezer/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "pnpm --filter @ebenezer/contracts build && vitest run",
    "test:pwa": "node scripts/offline-smoke.mjs",
    "bible:dataset": "node scripts/bible/prepare-dataset.mjs",
    "test:bible": "node --test scripts/bible/dataset.test.mjs",
    "bible:pin-model": "node scripts/bible/pin-model.mjs",
    "bible:embed": "node scripts/bible/generate-embeddings.mjs",
    "bible:evaluate": "node scripts/bible/evaluate.mjs",
    "bible:search": "node scripts/bible/search.mjs",
    "test:bible-browser": "node scripts/offline-smoke.mjs --bible",
    "bible:dataset:full": "node scripts/bible/prepare-full-dataset.mjs",
    "bible:embed:full": "node scripts/bible/generate-full-embeddings.mjs",
    "bible:evaluate:full": "node scripts/bible/evaluate-full.mjs",
    "test:bible:full": "node --test scripts/bible/full-dataset.test.mjs"
  },
  "dependencies": {
    "@ebenezer/contracts": "workspace:*",
    "@fontsource-variable/plus-jakarta-sans": "^5.0.0",
    "@hookform/resolvers": "^5.0.0",
    "@huggingface/transformers": "3.8.1",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.0.0",
    "i18next": "^25.0.0",
    "lucide-react": "^0.468.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
