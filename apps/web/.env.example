VITE_API_URL=http://localhost:3001

# Supabase Auth: browser-safe configuration only.
# Never put a database password or secret/service-role key in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web Push public key (safe to expose). Must match VAPID_PUBLIC_KEY in Supabase secrets.
# Generate a pair once; see docs/notifications-setup.md.
VITE_VAPID_PUBLIC_KEY=
