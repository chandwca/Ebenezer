PORT=3001
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# Profile API: use a publishable key and the verified user's JWT.
# Leave both empty to run /health without account services.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional AI encouragement. Keep the API key on the backend only.
# none uses prepared content; gemini enables Google AI Studio requests.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# YouVersion Platform: register Ebenezer and enable the public-domain BSB (3034).
# Backend only. Without a key or during outages, passages use the verified WEB fallback.
YOUVERSION_APP_KEY=
